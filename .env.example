# ============================
# IT Copilot Application
# ============================

IT_COPILOT_APP_NAME=IT Copilot
IT_COPILOT_APP_VERSION=0.2.0
IT_COPILOT_APP_DESCRIPTION=AI-powered IT assistant for employee self-service troubleshooting, ticketing, and audit.

IT_COPILOT_ENVIRONMENT=development
IT_COPILOT_DEBUG=true
IT_COPILOT_LOG_LEVEL=INFO

# ============================
# Assistant
# ============================

# Number of clarifying exchanges before the assistant escalates
IT_COPILOT_MAX_CLARIFYING_QUESTIONS=3

# Auto-create a documented ticket when the assistant resolves an issue
IT_COPILOT_AUTO_TICKET_ON_RESOLUTION=true

# ============================
# AI
# ============================

# Copy .env.example to .env and set your key here. The .env file is
# gitignored and must never be committed.
IT_COPILOT_ANTHROPIC_API_KEY=
IT_COPILOT_CHAT_MODEL=claude-sonnet-5
IT_COPILOT_EMBEDDING_MODEL=local
