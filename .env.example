# ============================
# TriageBot Application
# ============================

TRIAGEBOT_APP_NAME=TriageBot
TRIAGEBOT_APP_VERSION=0.2.0
TRIAGEBOT_APP_DESCRIPTION=AI-powered IT assistant for employee self-service troubleshooting, ticketing, and audit.

TRIAGEBOT_ENVIRONMENT=development
TRIAGEBOT_DEBUG=true
TRIAGEBOT_LOG_LEVEL=INFO

# ============================
# Assistant
# ============================

# Number of clarifying exchanges before the assistant escalates
TRIAGEBOT_MAX_CLARIFYING_QUESTIONS=3

# Auto-create a documented ticket when the assistant resolves an issue
TRIAGEBOT_AUTO_TICKET_ON_RESOLUTION=true

# ============================
# AI
# ============================

# Copy .env.example to .env and set your key here. The .env file is
# gitignored and must never be committed.
TRIAGEBOT_ANTHROPIC_API_KEY=
TRIAGEBOT_CHAT_MODEL=claude-sonnet-5
TRIAGEBOT_EMBEDDING_MODEL=local
